# Copy this file to backend/.env when running with npm.
# If you use Docker, copy it to the project-root .env file instead.
# For Docker, it contains shared configuration for the whole project.
# Review and replace the example values for your setup.

# PostgreSQL
POSTGRES_USER=widget_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=widget_platform

# Local PostgreSQL connection string
DATABASE_URL=postgres://widget_user:replace-with-a-strong-password@localhost:5432/widget_platform

# Application
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used to build the embed <script> snippet returned with each widget
APP_BASE_URL=http://localhost:4000

# Where owner verification and reset links point (the frontend, not the API)
FRONTEND_BASE_URL=http://localhost:5173

# Public backend URL used by the frontend
VITE_API_BASE_URL=http://localhost:4000

# Comma-separated allowlist for public endpoints in production; '*' for development
ALLOWED_ORIGINS=*

# Abuse protection (per IP + widget)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=10

# Geo enrichment provider timeout
GEO_PROVIDER_TIMEOUT_MS=2000

# Safe side effect: 'console' (default, logs only) or 'smtp'
MAILER=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=widget-platform@example.com

# Email verification + forgot/reset password for OWNER accounts.
# These features require MAILER=smtp plus SMTP_USER and SMTP_PASS; otherwise
# their UI is hidden and change-password remains available while logged in.
EMAIL_FEATURES_ENABLED=true

# When true (default), a new owner account is only created AFTER the
# verification link is clicked — registration just stages the signup
# and sends the email. Set to 'false' to create the account
# immediately and let the user log in without verifying at all.
# Ignored (treated as false) if EMAIL_FEATURES_ENABLED is false.
REQUIRE_EMAIL_VERIFICATION=true

# Where verification/reset links in emails point (the frontend, not the API)
FRONTEND_BASE_URL=http://localhost:5173

# The platform admin is just a tenant account with role='admin',
# created automatically at server startup from these two values.
# Leave both blank to skip creating an admin account entirely —
# /api/admin/* then stays unreachable by anyone. Log in with these
# same credentials at the normal /login page; you'll land in the
# admin area instead of the regular dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=
